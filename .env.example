# Supabase project that issues Job Chale's access tokens (no trailing slash).
# Tokens are verified against its public keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json,
# so no secret is needed here. Production: https://srsgupdatmvdtcpglfmn.supabase.co
# Copy this file to .env and fill in real values. Never commit .env.
SUPABASE_URL=

APP_ENV=development
PORT=8000

# DeepSeek / OpenAI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Security
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60
ENABLE_SECURITY_VALIDATION=true
SECURITY_LOG_LEVEL=WARNING
